{
  "$defs": {
    "AgentSpec": {
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "enum": [
            "fake",
            "scripted",
            "python"
          ],
          "title": "Adapter",
          "type": "string"
        },
        "config": {
          "$ref": "#/$defs/FakeAgentConfig"
        },
        "entrypoint": {
          "anyOf": [
            {
              "maxLength": 300,
              "minLength": 3,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entrypoint"
        }
      },
      "required": [
        "adapter"
      ],
      "title": "AgentSpec",
      "type": "object"
    },
    "AssertionOperator": {
      "enum": [
        "eq",
        "not_eq",
        "exists",
        "absent",
        "contains",
        "gte",
        "lte",
        "unchanged",
        "changed",
        "length_eq"
      ],
      "type": "string"
    },
    "AssertionSpec": {
      "additionalProperties": false,
      "properties": {
        "expected": {
          "default": null,
          "title": "Expected"
        },
        "operator": {
          "$ref": "#/$defs/AssertionOperator"
        },
        "path": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "tolerance": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tolerance"
        }
      },
      "required": [
        "path",
        "operator"
      ],
      "title": "AssertionSpec",
      "type": "object"
    },
    "BudgetSpec": {
      "additionalProperties": false,
      "properties": {
        "max_tool_calls": {
          "default": 20,
          "maximum": 10000,
          "minimum": 0,
          "title": "Max Tool Calls",
          "type": "integer"
        },
        "tool_timeout_seconds": {
          "default": 30,
          "maximum": 300,
          "minimum": 1,
          "title": "Tool Timeout Seconds",
          "type": "integer"
        },
        "wall_time_seconds": {
          "default": 120,
          "maximum": 3600,
          "minimum": 1,
          "title": "Wall Time Seconds",
          "type": "integer"
        }
      },
      "title": "BudgetSpec",
      "type": "object"
    },
    "EnvironmentRef": {
      "additionalProperties": false,
      "properties": {
        "compose_file": {
          "anyOf": [
            {
              "format": "path",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Compose File"
        },
        "definition": {
          "format": "path",
          "title": "Definition",
          "type": "string"
        },
        "driver": {
          "enum": [
            "fake",
            "docker_compose"
          ],
          "title": "Driver",
          "type": "string"
        }
      },
      "required": [
        "driver",
        "definition"
      ],
      "title": "EnvironmentRef",
      "type": "object"
    },
    "FakeAgentConfig": {
      "additionalProperties": false,
      "properties": {
        "message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        },
        "outcome": {
          "default": "success",
          "enum": [
            "success",
            "error"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "output": {
          "default": null,
          "title": "Output"
        }
      },
      "title": "FakeAgentConfig",
      "type": "object"
    },
    "FakeGraderSpec": {
      "additionalProperties": false,
      "properties": {
        "critical": {
          "default": true,
          "title": "Critical",
          "type": "boolean"
        },
        "explanation": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "outcome": {
          "default": "PASS",
          "enum": [
            "PASS",
            "FAIL",
            "ERROR"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "type": {
          "const": "fake",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "explanation"
      ],
      "title": "FakeGraderSpec",
      "type": "object"
    },
    "GraderSpec": {
      "discriminator": {
        "mapping": {
          "fake": "#/$defs/FakeGraderSpec",
          "state_assertion": "#/$defs/StateAssertionGraderSpec",
          "test_command": "#/$defs/TestCommandGraderSpec"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/FakeGraderSpec"
        },
        {
          "$ref": "#/$defs/StateAssertionGraderSpec"
        },
        {
          "$ref": "#/$defs/TestCommandGraderSpec"
        }
      ]
    },
    "Metadata": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "tags": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "title"
      ],
      "title": "Metadata",
      "type": "object"
    },
    "OutputSpec": {
      "additionalProperties": false,
      "properties": {
        "retain_environment_on_failure": {
          "default": false,
          "title": "Retain Environment On Failure",
          "type": "boolean"
        }
      },
      "title": "OutputSpec",
      "type": "object"
    },
    "StateAssertionGraderSpec": {
      "additionalProperties": false,
      "properties": {
        "assertions": {
          "items": {
            "$ref": "#/$defs/AssertionSpec"
          },
          "minItems": 1,
          "title": "Assertions",
          "type": "array"
        },
        "critical": {
          "default": true,
          "title": "Critical",
          "type": "boolean"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "type": {
          "const": "state_assertion",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "assertions"
      ],
      "title": "StateAssertionGraderSpec",
      "type": "object"
    },
    "TaskSpec": {
      "additionalProperties": false,
      "properties": {
        "context": {
          "additionalProperties": true,
          "title": "Context",
          "type": "object"
        },
        "input": {
          "additionalProperties": true,
          "title": "Input",
          "type": "object"
        }
      },
      "required": [
        "input"
      ],
      "title": "TaskSpec",
      "type": "object"
    },
    "TestCommandGraderSpec": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Command",
          "type": "array"
        },
        "critical": {
          "default": true,
          "title": "Critical",
          "type": "boolean"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "service": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Service",
          "type": "string"
        },
        "timeout_seconds": {
          "default": 30,
          "maximum": 600,
          "minimum": 1,
          "title": "Timeout Seconds",
          "type": "integer"
        },
        "type": {
          "const": "test_command",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "service",
        "command"
      ],
      "title": "TestCommandGraderSpec",
      "type": "object"
    },
    "ToolSpec": {
      "additionalProperties": false,
      "properties": {
        "allow": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Allow",
          "type": "array"
        },
        "provider": {
          "maxLength": 300,
          "minLength": 3,
          "title": "Provider",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "allow"
      ],
      "title": "ToolSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "agent": {
      "$ref": "#/$defs/AgentSpec"
    },
    "api_version": {
      "const": "reprocase.dev/v0",
      "title": "Api Version",
      "type": "string"
    },
    "budgets": {
      "$ref": "#/$defs/BudgetSpec"
    },
    "environment": {
      "$ref": "#/$defs/EnvironmentRef"
    },
    "graders": {
      "items": {
        "$ref": "#/$defs/GraderSpec"
      },
      "minItems": 1,
      "title": "Graders",
      "type": "array"
    },
    "kind": {
      "const": "EvalCase",
      "title": "Kind",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/Metadata"
    },
    "output": {
      "$ref": "#/$defs/OutputSpec"
    },
    "task": {
      "$ref": "#/$defs/TaskSpec"
    },
    "tools": {
      "anyOf": [
        {
          "$ref": "#/$defs/ToolSpec"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "api_version",
    "kind",
    "metadata",
    "task",
    "agent",
    "environment",
    "graders"
  ],
  "title": "EvalCase",
  "type": "object"
}
