{
  "$defs": {
    "AgentIdentity": {
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "title": "Adapter",
          "type": "string"
        },
        "code": {
          "anyOf": [
            {
              "$ref": "#/$defs/CodeIdentity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "entrypoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entrypoint"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "provider_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/CodeIdentity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "adapter"
      ],
      "title": "AgentIdentity",
      "type": "object"
    },
    "CaseIdentity": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "title": "Digest",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "digest",
        "path"
      ],
      "title": "CaseIdentity",
      "type": "object"
    },
    "CodeIdentity": {
      "additionalProperties": false,
      "description": "Digest of the code behind an entrypoint (relative paths only, §6.2).",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "CodeIdentity",
      "type": "object"
    },
    "SourceIdentity": {
      "additionalProperties": false,
      "properties": {
        "git_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Git Commit"
        },
        "git_dirty": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Git Dirty"
        },
        "platform": {
          "title": "Platform",
          "type": "string"
        },
        "python": {
          "title": "Python",
          "type": "string"
        }
      },
      "required": [
        "python",
        "platform"
      ],
      "title": "SourceIdentity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "agent": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentIdentity"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "budget": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Budget",
      "type": "object"
    },
    "case": {
      "$ref": "#/$defs/CaseIdentity"
    },
    "components": {
      "default": [
        "fake_environment",
        "fake_agent",
        "fake_grader"
      ],
      "items": {
        "enum": [
          "fake_environment",
          "fake_agent",
          "fake_grader",
          "compose_environment",
          "scripted_actor",
          "deterministic_graders",
          "python_agent",
          "tool_broker"
        ],
        "type": "string"
      },
      "title": "Components",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "reproducibility_level": {
      "default": "R0",
      "enum": [
        "R0",
        "R1"
      ],
      "title": "Reproducibility Level",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "reprocase.run-manifest/v0",
      "default": "reprocase.run-manifest/v0",
      "title": "Schema Version",
      "type": "string"
    },
    "seed": {
      "default": 0,
      "title": "Seed",
      "type": "integer"
    },
    "source": {
      "$ref": "#/$defs/SourceIdentity"
    }
  },
  "required": [
    "run_id",
    "case",
    "source",
    "budget"
  ],
  "title": "RunManifest",
  "type": "object"
}
