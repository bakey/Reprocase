{
  "$defs": {
    "AgentIdentity": {
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "title": "Adapter",
          "type": "string"
        },
        "code": {
          "anyOf": [
            {
              "$ref": "#/$defs/CodeIdentity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "entrypoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entrypoint"
        },
        "entrypoint_override": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entrypoint Override"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "provider_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/CodeIdentity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "adapter"
      ],
      "title": "AgentIdentity",
      "type": "object"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "media_type",
        "path",
        "size_bytes",
        "sha256"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "AssertionResult": {
      "additionalProperties": false,
      "properties": {
        "actual": {
          "default": null,
          "title": "Actual"
        },
        "expected": {
          "default": null,
          "title": "Expected"
        },
        "explanation": {
          "default": "",
          "title": "Explanation",
          "type": "string"
        },
        "operator": {
          "title": "Operator",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/GraderStatus"
        }
      },
      "required": [
        "path",
        "operator",
        "status"
      ],
      "title": "AssertionResult",
      "type": "object"
    },
    "CaseIdentity": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "title": "Digest",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "relative_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relative Path"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "digest",
        "path"
      ],
      "title": "CaseIdentity",
      "type": "object"
    },
    "CodeIdentity": {
      "additionalProperties": false,
      "description": "Digest of the code behind an entrypoint (relative paths only, §6.2).",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "CodeIdentity",
      "type": "object"
    },
    "FailureAttribution": {
      "enum": [
        "CASE_ERROR",
        "AGENT_FAILURE",
        "ENVIRONMENT_ERROR",
        "GRADER_ERROR",
        "RUNNER_ERROR"
      ],
      "title": "FailureAttribution",
      "type": "string"
    },
    "FailureCode": {
      "enum": [
        "CASE_SCHEMA_INVALID",
        "CASE_REFERENCE_MISSING",
        "CASE_REFERENCE_OUTSIDE_ROOT",
        "CASE_UNSUPPORTED_DRIVER",
        "CASE_ENTRYPOINT_INVALID",
        "ENV_FAKE_START_FAILED",
        "ENV_FAKE_HEALTHCHECK_FAILED",
        "ENV_COMPOSE_UNSAFE",
        "ENV_COMPOSE_INVALID",
        "ENV_START_FAILED",
        "ENV_RESTORE_FAILED",
        "ENV_HEALTHCHECK_FAILED",
        "ENV_STATE_CAPTURE_FAILED",
        "ENV_STATE_INVALID",
        "ENV_TEARDOWN_FAILED",
        "AGENT_FAKE_EXECUTION_FAILED",
        "AGENT_EXCEPTION",
        "AGENT_TIMEOUT",
        "AGENT_OUTPUT_INVALID",
        "AGENT_BUDGET_EXCEEDED",
        "TOOL_NOT_ALLOWED",
        "TOOL_ARGUMENT_INVALID",
        "TOOL_TIMEOUT",
        "TOOL_EXECUTION_FAILED",
        "GRADER_FAKE_EXECUTION_FAILED",
        "GRADER_ASSERTION_FAILED",
        "GRADER_EXECUTION_ERROR",
        "GRADER_OUTPUT_INVALID",
        "GRADER_TIMEOUT",
        "TEST_COMMAND_FAILED",
        "INVARIANT_VIOLATED",
        "TEMPORAL_CONSTRAINT_VIOLATED",
        "TOOL_POLICY_VIOLATED",
        "RUNNER_INVALID_TRANSITION",
        "RUNNER_STORAGE_ERROR",
        "RUNNER_INTERNAL_ERROR",
        "RUNNER_EVIDENCE_INCOMPLETE",
        "RUN_CANCELLED"
      ],
      "title": "FailureCode",
      "type": "string"
    },
    "FailureRecord": {
      "additionalProperties": false,
      "properties": {
        "attribution": {
          "$ref": "#/$defs/FailureAttribution"
        },
        "code": {
          "$ref": "#/$defs/FailureCode"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "attribution",
        "code",
        "message"
      ],
      "title": "FailureRecord",
      "type": "object"
    },
    "GraderResult": {
      "additionalProperties": false,
      "properties": {
        "actual": {
          "default": null,
          "title": "Actual"
        },
        "assertions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AssertionResult"
          },
          "title": "Assertions",
          "type": "array"
        },
        "critical": {
          "title": "Critical",
          "type": "boolean"
        },
        "duration_ms": {
          "default": 0,
          "minimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "evidence": {
          "default": [],
          "items": {},
          "title": "Evidence",
          "type": "array"
        },
        "expected": {
          "default": null,
          "title": "Expected"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "grader_digest": {
          "default": "",
          "title": "Grader Digest",
          "type": "string"
        },
        "grader_id": {
          "title": "Grader Id",
          "type": "string"
        },
        "grader_type": {
          "default": "fake",
          "title": "Grader Type",
          "type": "string"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "status": {
          "$ref": "#/$defs/GraderStatus"
        },
        "warnings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "grader_id",
        "status",
        "critical",
        "explanation"
      ],
      "title": "GraderResult",
      "type": "object"
    },
    "GraderStatus": {
      "enum": [
        "PASS",
        "FAIL",
        "ERROR",
        "SKIPPED"
      ],
      "title": "GraderStatus",
      "type": "string"
    },
    "RunState": {
      "enum": [
        "CREATED",
        "VALIDATING",
        "PREPARING_ENVIRONMENT",
        "STARTING_ENVIRONMENT",
        "RESTORING_ENVIRONMENT",
        "HEALTHCHECKING",
        "CAPTURING_INITIAL_STATE",
        "LOADING_AGENT_AND_TOOLS",
        "RUNNING_AGENT",
        "CAPTURING_FINAL_STATE",
        "GRADING",
        "COLLECTING_ARTIFACTS",
        "TEARING_DOWN",
        "WRITING_RESULT",
        "FAILED",
        "CANCELLED",
        "COMPLETED",
        "COMPLETED_WITH_ERROR"
      ],
      "title": "RunState",
      "type": "string"
    },
    "RunStatus": {
      "enum": [
        "COMPLETED",
        "COMPLETED_WITH_ERROR",
        "CANCELLED"
      ],
      "title": "RunStatus",
      "type": "string"
    },
    "StateSnapshot": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "canonicalization_digest": {
          "title": "Canonicalization Digest",
          "type": "string"
        },
        "captured_at": {
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        },
        "content_digest": {
          "title": "Content Digest",
          "type": "string"
        },
        "phase": {
          "enum": [
            "initial",
            "final"
          ],
          "title": "Phase",
          "type": "string"
        },
        "schema_version": {
          "const": "reprocase.state/v0",
          "default": "reprocase.state/v0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "captured_at",
        "phase",
        "canonicalization_digest",
        "content_digest",
        "artifact"
      ],
      "title": "StateSnapshot",
      "type": "object"
    },
    "Usage": {
      "additionalProperties": false,
      "description": "Observed usage; unknown model metrics stay null, never zero (§13.3).",
      "properties": {
        "cost_usd": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Usd"
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "model_calls": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Calls"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "tool_calls": {
          "default": 0,
          "minimum": 0,
          "title": "Tool Calls",
          "type": "integer"
        }
      },
      "title": "Usage",
      "type": "object"
    },
    "Verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "INVALID"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "agent": {
      "anyOf": [
        {
          "$ref": "#/$defs/AgentIdentity"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "agent_output": {
      "default": null,
      "title": "Agent Output"
    },
    "artifacts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "case": {
      "$ref": "#/$defs/CaseIdentity"
    },
    "cleanup_command": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cleanup Command"
    },
    "cleanup_required": {
      "default": false,
      "title": "Cleanup Required",
      "type": "boolean"
    },
    "duration_ms": {
      "minimum": 0,
      "title": "Duration Ms",
      "type": "integer"
    },
    "final_state": {
      "$ref": "#/$defs/RunState"
    },
    "finished_at": {
      "format": "date-time",
      "title": "Finished At",
      "type": "string"
    },
    "graders": {
      "default": [],
      "items": {
        "$ref": "#/$defs/GraderResult"
      },
      "title": "Graders",
      "type": "array"
    },
    "primary_failure": {
      "anyOf": [
        {
          "$ref": "#/$defs/FailureRecord"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "reproducibility_level": {
      "default": "R0",
      "enum": [
        "R0",
        "R1"
      ],
      "title": "Reproducibility Level",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "safety_violation": {
      "default": false,
      "title": "Safety Violation",
      "type": "boolean"
    },
    "schema_version": {
      "const": "reprocase.run-result/v0",
      "default": "reprocase.run-result/v0",
      "title": "Schema Version",
      "type": "string"
    },
    "secondary_failures": {
      "default": [],
      "items": {
        "$ref": "#/$defs/FailureRecord"
      },
      "title": "Secondary Failures",
      "type": "array"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "state_diff": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "states": {
      "default": [],
      "items": {
        "$ref": "#/$defs/StateSnapshot"
      },
      "title": "States",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/RunStatus"
    },
    "usage": {
      "anyOf": [
        {
          "$ref": "#/$defs/Usage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "verdict": {
      "$ref": "#/$defs/Verdict"
    },
    "warnings": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "status",
    "verdict",
    "final_state",
    "case",
    "started_at",
    "finished_at",
    "duration_ms"
  ],
  "title": "RunResult",
  "type": "object"
}
