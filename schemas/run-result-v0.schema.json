{
  "$defs": {
    "CaseIdentity": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "title": "Digest",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "digest",
        "path"
      ],
      "title": "CaseIdentity",
      "type": "object"
    },
    "FailureAttribution": {
      "enum": [
        "CASE_ERROR",
        "AGENT_FAILURE",
        "ENVIRONMENT_ERROR",
        "GRADER_ERROR",
        "RUNNER_ERROR"
      ],
      "title": "FailureAttribution",
      "type": "string"
    },
    "FailureCode": {
      "enum": [
        "CASE_SCHEMA_INVALID",
        "CASE_REFERENCE_MISSING",
        "CASE_REFERENCE_OUTSIDE_ROOT",
        "CASE_UNSUPPORTED_DRIVER",
        "ENV_FAKE_START_FAILED",
        "ENV_FAKE_HEALTHCHECK_FAILED",
        "ENV_COMPOSE_UNSAFE",
        "ENV_COMPOSE_INVALID",
        "ENV_START_FAILED",
        "ENV_RESTORE_FAILED",
        "ENV_HEALTHCHECK_FAILED",
        "ENV_STATE_CAPTURE_FAILED",
        "ENV_STATE_INVALID",
        "ENV_TEARDOWN_FAILED",
        "AGENT_FAKE_EXECUTION_FAILED",
        "GRADER_FAKE_EXECUTION_FAILED",
        "GRADER_ASSERTION_FAILED",
        "RUNNER_INVALID_TRANSITION",
        "RUNNER_STORAGE_ERROR",
        "RUNNER_INTERNAL_ERROR",
        "RUN_CANCELLED"
      ],
      "title": "FailureCode",
      "type": "string"
    },
    "FailureRecord": {
      "additionalProperties": false,
      "properties": {
        "attribution": {
          "$ref": "#/$defs/FailureAttribution"
        },
        "code": {
          "$ref": "#/$defs/FailureCode"
        },
        "details": {
          "additionalProperties": true,
          "title": "Details",
          "type": "object"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "attribution",
        "code",
        "message"
      ],
      "title": "FailureRecord",
      "type": "object"
    },
    "GraderResult": {
      "additionalProperties": false,
      "properties": {
        "critical": {
          "title": "Critical",
          "type": "boolean"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "grader_id": {
          "title": "Grader Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/GraderStatus"
        }
      },
      "required": [
        "grader_id",
        "status",
        "critical",
        "explanation"
      ],
      "title": "GraderResult",
      "type": "object"
    },
    "GraderStatus": {
      "enum": [
        "PASS",
        "FAIL",
        "ERROR"
      ],
      "title": "GraderStatus",
      "type": "string"
    },
    "RunState": {
      "enum": [
        "CREATED",
        "VALIDATING",
        "PREPARING_ENVIRONMENT",
        "STARTING_ENVIRONMENT",
        "RESTORING_ENVIRONMENT",
        "HEALTHCHECKING",
        "CAPTURING_INITIAL_STATE",
        "LOADING_AGENT_AND_TOOLS",
        "RUNNING_AGENT",
        "CAPTURING_FINAL_STATE",
        "GRADING",
        "COLLECTING_ARTIFACTS",
        "TEARING_DOWN",
        "WRITING_RESULT",
        "FAILED",
        "CANCELLED",
        "COMPLETED",
        "COMPLETED_WITH_ERROR"
      ],
      "title": "RunState",
      "type": "string"
    },
    "RunStatus": {
      "enum": [
        "COMPLETED",
        "COMPLETED_WITH_ERROR",
        "CANCELLED"
      ],
      "title": "RunStatus",
      "type": "string"
    },
    "Verdict": {
      "enum": [
        "PASS",
        "FAIL",
        "INVALID"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "agent_output": {
      "default": null,
      "title": "Agent Output"
    },
    "case": {
      "$ref": "#/$defs/CaseIdentity"
    },
    "duration_ms": {
      "minimum": 0,
      "title": "Duration Ms",
      "type": "integer"
    },
    "final_state": {
      "$ref": "#/$defs/RunState"
    },
    "finished_at": {
      "format": "date-time",
      "title": "Finished At",
      "type": "string"
    },
    "graders": {
      "default": [],
      "items": {
        "$ref": "#/$defs/GraderResult"
      },
      "title": "Graders",
      "type": "array"
    },
    "primary_failure": {
      "anyOf": [
        {
          "$ref": "#/$defs/FailureRecord"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "reprocase.run-result/v0",
      "default": "reprocase.run-result/v0",
      "title": "Schema Version",
      "type": "string"
    },
    "secondary_failures": {
      "default": [],
      "items": {
        "$ref": "#/$defs/FailureRecord"
      },
      "title": "Secondary Failures",
      "type": "array"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/RunStatus"
    },
    "verdict": {
      "$ref": "#/$defs/Verdict"
    },
    "warnings": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "status",
    "verdict",
    "final_state",
    "case",
    "started_at",
    "finished_at",
    "duration_ms"
  ],
  "title": "RunResult",
  "type": "object"
}
